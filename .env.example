# Firebase (Firestore only — login is users/{username} in Firestore)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Server (Admin SDK): service account JSON from Project settings → Service accounts. Keep it outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# Local emulators (npm run emulators) — leave unset in production
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Public base URL, used in payment links and WhatsApp receipt links
APP_URL=http://localhost:3000

# Razorpay — leave KEY_ID empty to use the built-in mock checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Backblaze B2 — public bucket for receipt PDFs. Leave empty to serve receipts from /r/{id}/pdf instead.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# RichAutomate WhatsApp — leave API_KEY empty to log messages to the console. Template names as approved in
# RichAutomate → Templates; LANG must match the template's language exactly (en or en_US).
RICHAUTOMATE_API_KEY=
RICHAUTOMATE_LANG=en
RICHAUTOMATE_TEMPLATE_HOLD=booking_on_hold
RICHAUTOMATE_TEMPLATE_CONFIRMED=booking_confirmed
RICHAUTOMATE_TEMPLATE_CANCELLED=booking_cancelled
RICHAUTOMATE_TEMPLATE_REMINDER=booking_reminder
# Day-before booking reminder: Cloud Scheduler sends  Authorization: Bearer <CRON_SECRET>  to /api/cron/reminders
CRON_SECRET=
# SMS fallback (when WhatsApp fails or no consent): MSG91 key + DLT-approved SMS template IDs. Empty = console log.
MSG91_AUTHKEY=
MSG91_SMS_TEMPLATE_HOLD=
MSG91_SMS_TEMPLATE_CONFIRMED=
MSG91_SMS_TEMPLATE_CANCELLED=
MSG91_SMS_TEMPLATE_REMINDER=

# GST invoice numbers: <prefix>/<financial year>/<n>, e.g. HB/26-27/0001. GSTIN printed on receipts if set.
GST_INVOICE_PREFIX=HB
TRUST_GSTIN=
