# Firebase (API key is used server-side for Auth REST sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Server: Admin SDK uses Application Default Credentials (App Hosting) or
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json locally.

# Local emulators (npm run emulators) — leave unset in production
# NEXT_PUBLIC_AUTH_EMULATOR=http://127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Public base URL, used in payment links and WhatsApp receipt links
APP_URL=http://localhost:3000

# Razorpay — leave KEY_ID empty to use the built-in mock checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MSG91 WhatsApp — leave AUTHKEY empty to log messages to the console
MSG91_AUTHKEY=
MSG91_WA_NUMBER=
MSG91_WA_NAMESPACE=
MSG91_WA_LANG=en
MSG91_WA_TEMPLATE_CONFIRMED=booking_confirmed
MSG91_WA_TEMPLATE_CANCELLED=booking_cancelled
MSG91_WA_TEMPLATE_HOLD=booking_on_hold
MSG91_WA_TEMPLATE_OTP=login_otp
