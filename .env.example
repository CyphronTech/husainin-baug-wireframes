# Firebase (Firestore only — login is users/{username} in Firestore)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Server (Admin SDK): service account JSON from Project settings → Service accounts. Keep it outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# Local emulators (npm run emulators) — leave unset in production
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Public base URL, used in payment links and WhatsApp receipt links
APP_URL=http://localhost:3000

# Razorpay — leave KEY_ID empty to use the built-in mock checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Backblaze B2 — public bucket for receipt PDFs. Leave empty to serve receipts from /r/{id}/pdf instead.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# MSG91 WhatsApp — leave AUTHKEY empty to log messages to the console
MSG91_AUTHKEY=
MSG91_WA_NUMBER=
MSG91_WA_NAMESPACE=
MSG91_WA_LANG=en
MSG91_WA_TEMPLATE_CONFIRMED=booking_confirmed
MSG91_WA_TEMPLATE_CANCELLED=booking_cancelled
MSG91_WA_TEMPLATE_HOLD=booking_on_hold
